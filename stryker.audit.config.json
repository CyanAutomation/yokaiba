{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/generation/audit.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --import tsx --test tests/audit-corpus.test.ts"
  },
  "inPlace": true,
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "progress"],
  "concurrency": 2,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  }
}
