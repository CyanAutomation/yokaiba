{
  "name": "yokaiba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "solver:rust:test": "cargo test --manifest-path rust/solver/Cargo.toml",
    "solver:rust:build": "cargo build --manifest-path rust/solver/Cargo.toml --release --target wasm32-unknown-unknown",
    "solver:rust:check": "cargo fmt --manifest-path rust/solver/Cargo.toml -- --check && cargo clippy --manifest-path rust/solver/Cargo.toml --target wasm32-unknown-unknown -- -D warnings && npm run solver:rust:test && npm run solver:rust:build",
    "test": "npm run solver:rust:check && node --import tsx --test tests/*.test.ts",
    "docs:check": "markdownlint-cli2 README.md \"docs/**/*.md\" \".github/skills/**/*.md\" && node --import tsx scripts/check-docs.ts",
    "docs:links": "tsx scripts/check-external-doc-links.ts",
    "test:coverage": "npm run solver:rust:check && c8 --reporter=json --reports-dir=coverage node --import tsx --test tests/*.test.ts",
    "dev": "npm run solver:rust:build && wrangler dev",
    "audit:difficulty": "tsx scripts/audit-difficulty.mts",
    "audit:difficulty:v5": "tsx scripts/audit-difficulty-v5.mts",
    "audit:difficulty:targeted": "tsx scripts/audit-targeted-difficulty.mts",
    "audit:jev": "tsx scripts/audit-jev.mts",
    "audit:jev:distance-wording": "tsx scripts/audit-jev-distance-phrasing.mts",
    "audit:jev:calibration": "tsx scripts/audit-jev-calibration.mts",
    "deployment:record-output": "tsx scripts/record-deployment-output.mts",
    "deployment:health": "tsx scripts/health-deployment.mts",
    "deployment:smoke": "tsx scripts/smoke-deployment.mts",
    "deployment:contract": "tsx scripts/contract-deployment.mts",
    "fallow:health": "fallow health --report-only",
    "fallow:audit": "fallow audit --gate new-only",
    "fallow:policy": "fallow dead-code --config .github/fallow/policy-config.json --policy-violations --format compact --quiet",
    "deploy": "npm run solver:rust:build && wrangler deploy"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "fallow": "^3.43.2",
    "markdownlint-cli2": "^0.24.2",
    "smol-toml": "^1.9.1",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
