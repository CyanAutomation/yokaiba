{
  "name": "yokaiba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "docs:check": "markdownlint-cli2 README.md \"docs/**/*.md\" \".github/skills/**/*.md\" && node --import tsx scripts/check-docs.ts",
    "docs:links": "tsx scripts/check-external-doc-links.ts",
    "test:coverage": "c8 --reporter=json --reports-dir=coverage node --import tsx --test tests/*.test.ts",
    "dev": "wrangler dev",
    "audit:difficulty": "tsx scripts/audit-difficulty.mts",
    "audit:difficulty:v5": "tsx scripts/audit-difficulty-v5.mts",
    "audit:difficulty:targeted": "tsx scripts/audit-targeted-difficulty.mts",
    "audit:jev": "tsx scripts/audit-jev.mts",
    "audit:jev:distance-wording": "tsx scripts/audit-jev-distance-phrasing.mts",
    "deployment:record-output": "tsx scripts/record-deployment-output.mts",
    "deployment:health": "tsx scripts/health-deployment.mts",
    "deployment:smoke": "tsx scripts/smoke-deployment.mts",
    "deployment:contract": "tsx scripts/contract-deployment.mts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "fallow": "^3.37.0",
    "markdownlint-cli2": "^0.24.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
